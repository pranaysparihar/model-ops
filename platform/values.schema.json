{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["cloud", "gpu", "workload", "monitoring"],
  "properties": {
    "repoURL": {"type": "string", "pattern": "^https://|^ssh://|^git@"},
    "cloud": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "gpu": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 4},
        "capacityType": {"enum": ["on-demand", "spot"]},
        "amiID": {"type": "string", "pattern": "^$|^ami-[0-9a-f]{8,17}$"},
        "instanceTypes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 0, "maximum": 1},
        "imageTag": {"type": "string", "pattern": "^$|^[0-9a-f]{40}$"}
      }
    }
  }
}
